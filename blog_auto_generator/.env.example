# Claude API 키 (https://console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# YouTube Data API v3 키 (https://console.cloud.google.com 에서 발급)
# YouTube 없이 PDF만 사용하려면 비워두세요
YOUTUBE_API_KEY=AIzaxxxxxxxxxxxxxxxx

# 최송철TV 채널 ID
# 채널 페이지 URL에서 확인: https://www.youtube.com/@채널명 → 소스에서 channelId 검색
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx

# 자담인 건강법 PDF 파일 경로 (절대경로 또는 상대경로)
PDF_PATH=자담인건강법.pdf
